---
import { ViewTransitions } from 'astro:transitions';
import ThemeScript from '@theme/ThemeScript.astro';
import { switchLocalePath } from '@i18n/routes';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  canonical?: string;
}

const {
  title = 'Fundación JD10',
  description = 'Hacia un uso responsable de la tecnología - Enseñamos el uso responsable de la IA y construimos herramientas gratuitas.',
  ogImage = '/og-default.png',
  lang = 'es',
  canonical,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);

// hreflang alternates for the current page, matching the built trailing-slash URLs.
// Codes stay generic (es/en/pt) to match the sitemap's hreflang values.
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const LOCALE_ALTERNATES = [
  { locale: 'es-419', hreflang: 'es' },
  { locale: 'en-US', hreflang: 'en' },
  { locale: 'pt-BR', hreflang: 'pt' },
] as const;
const alternates = LOCALE_ALTERNATES.map(({ locale, hreflang }) => ({
  hreflang,
  href: new URL(withSlash(switchLocalePath(Astro.url.pathname, locale)), Astro.site).toString(),
}));
const xDefaultURL = new URL(withSlash(switchLocalePath(Astro.url.pathname, 'es-419')), Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />
    <link rel="sitemap" href={new URL('/sitemap-index.xml', Astro.site).toString()} />
    <link rel="describedby" href={new URL('/llms.txt', Astro.site).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- JSON-LD for NGO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "Fundación JD10",
      "url": Astro.site?.toString(),
      "description": description,
      "foundingDate": "2026",
      "areaServed": "Latin America",
    })} />

    <ViewTransitions />
    <ThemeScript />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation loading bar -->
    <div id="nav-loader" class="fixed top-0 left-0 right-0 h-0.5 bg-[var(--color-text)] z-[100] opacity-0 transition-opacity duration-150" style="transform: scaleX(0); transform-origin: left;"></div>
    <slot />
    <script>
      const loader = document.getElementById('nav-loader');
      let animationFrame: number;
      let progress = 0;

      function startLoader() {
        if (!loader) return;
        progress = 0;
        loader.style.opacity = '1';
        loader.style.transform = 'scaleX(0)';
        
        function animate() {
          progress += (0.9 - progress) * 0.08;
          loader.style.transform = `scaleX(${progress})`;
          if (progress < 0.9) {
            animationFrame = requestAnimationFrame(animate);
          }
        }
        animate();
      }

      function completeLoader() {
        if (!loader) return;
        cancelAnimationFrame(animationFrame);
        loader.style.transform = 'scaleX(1)';
        setTimeout(() => {
          loader.style.opacity = '0';
          setTimeout(() => {
            loader.style.transform = 'scaleX(0)';
          }, 150);
        }, 100);
      }

      document.addEventListener('astro:before-preparation', startLoader);
      document.addEventListener('astro:after-swap', completeLoader);
    </script>
  </body>
</html>
