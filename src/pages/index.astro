---
// Static redirect: uses cookie for locale preference, defaults to /es/
---
<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      var match = document.cookie.match(/(?:^|; )locale=([^;]*)/);
      var locale = match ? decodeURIComponent(match[1]) : '';
      var lang = locale === 'en-US' ? 'en' : locale === 'pt-BR' ? 'pt' : 'es';
      window.location.replace('/' + lang + '/');
    </script>
    <meta http-equiv="refresh" content="0;url=/es/" />
    <title>Redirecting…</title>
  </head>
  <body></body>
</html>
