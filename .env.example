# Public site URL (used for sitemap, OG tags, canonical URLs)
PUBLIC_SITE_URL=https://fundacionjd10.com

# Cloudflare R2 — public bucket URL for serving images in blog posts
PUBLIC_R2_PUBLIC_URL=https://archivos.fundacionjd10.com

# Cloudflare R2 — credentials for upload scripts (never used at build/runtime)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fundacionjd10

# Contact form (Cloudflare Pages Function or external endpoint)
CONTACT_FORM_ENDPOINT=
